# Copy to .env and replace every value (./setup.sh does this for you).
COMPOSE_PROJECT_NAME=langfuse
NEXTAUTH_URL=http://localhost:3001
TELEMETRY_ENABLED=false

NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/postgres
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>

# Created on first start: organization, project, API keys and a login user
LANGFUSE_INIT_ORG_ID=inkwell
LANGFUSE_INIT_ORG_NAME=Inkwell
LANGFUSE_INIT_PROJECT_ID=blog-agent
LANGFUSE_INIT_PROJECT_NAME=blog-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@inkwell.local
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=
