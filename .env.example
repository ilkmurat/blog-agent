# Langfuse tracing (optional). Self-hosted: run ./langfuse/setup.sh, which fills these in.
# Cloud: create keys at https://cloud.langfuse.com → Settings → API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud by default; US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

OLLAMA_MODEL=qwen2.5:14b
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_CHATS=2
